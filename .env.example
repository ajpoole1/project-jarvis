# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenClaw Gateway
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
DISCORD_NOTIFY_USER_ID=your-discord-user-id-here

# Gmail OAuth2
GMAIL_CLIENT_ID=your-client-id
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8080/oauth2callback
GMAIL_BATCH_SIZE=50
GMAIL_DRY_RUN=true
JARVIS_CONFIG_DIR=/config/personal
JARVIS_DATA_DIR=/data

# Google Calendar
GOOGLE_CALENDAR_IDS=primary,your-family-calendar-id@group.calendar.google.com,en.canadian#holiday@group.v.calendar.google.com
JARVIS_TIMEZONE=America/Toronto

# Morning briefing
JARVIS_CITY=Your City

# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Database
JARVIS_DB_PATH=/data/jarvis.db

# Finance skill (Wealthica) — credentials from hello@wealthica.com
WEALTHICA_CLIENT_ID=your-wealthica-client-id
WEALTHICA_SECRET=your-wealthica-secret
WEALTHICA_USER=your-wealthica-account-email

# Tailscale (VPS <-> Pi communication)
TAILSCALE_PI_IP=100.x.x.x
TAILSCALE_VPS_IP=100.x.x.x

# Travel monitor (Amadeus Self-Service — production env; Firecrawl for hotels/packages)
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
FIRECRAWL_API_KEY=your-firecrawl-api-key
# TRAVEL_MONITOR_DEAL_DROP_PCT=10
# TRAVEL_MONITOR_N_MEDIAN=8
# TRAVEL_MONITOR_N_DAY_LOW=30
# TRAVEL_MONITOR_ESCALATE_DAYS=21
# TRAVEL_MONITOR_DEGRADE_AFTER=3
