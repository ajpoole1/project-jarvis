{
  "_comment": "Builder permission set — instantiated by onboard-repo.sh for each repo. See DEV_LOOP_REFERENCE §5 and §8.4.",
  "permissions": {
    "allow": [
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git push origin feature/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(scripts/dev-loop/start-build.sh:*)",
      "Bash(scripts/dev-loop/open-pr.sh:*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin develop:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(bash -c:*)",
      "Bash(python3 -c:*)",
      "Bash(eval:*)",
      "Bash(source:*)"
    ]
  }
}
